# Variables de entorno de SEPEI UNIDO
#
# Copia este archivo a .env.local (desarrollo) o configúralas en Vercel
# (Project Settings → Environment Variables) para preview y producción.
#
# ⚠️ REGLA IMPORTANTE: el prefijo VITE_ hace que Vite INCRUSTE el valor en el
# bundle JavaScript público — cualquiera puede leerlo con ver el código fuente
# de la web. Solo las variables de la primera sección pueden llevar ese prefijo.
# Nunca añadas VITE_ a una clave secreta.


# ─────────────────────────────────────────────────────────────────────────────
# PÚBLICAS — van al bundle del navegador (src/lib/supabase.ts)
# ─────────────────────────────────────────────────────────────────────────────

# URL del proyecto Supabase, p. ej. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Clave anónima de Supabase. Es pública por diseño: la protección real de los
# datos son las políticas RLS de cada tabla, no el secreto de esta clave.
VITE_SUPABASE_ANON_KEY=

# URL base del sitio, usada para construir los enlaces de los emails
# (api/auth.ts). Sin barra final.
VITE_APP_URL=https://www.sepeiunido.org


# ─────────────────────────────────────────────────────────────────────────────
# SECRETAS — solo servidor (funciones serverless de api/). NUNCA con prefijo VITE_
# ─────────────────────────────────────────────────────────────────────────────

# Clave service_role de Supabase: bypasa RLS por completo (api/_lib/supabaseAdmin.ts).
# Es la credencial más sensible del proyecto.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar los tokens de sesión de admin (api/_lib/adminAuth.ts).
# Generar con: openssl rand -hex 32
# Si falta, el login de admin falla con 500 — ya ocurrió en 2026-09.
SESSION_SECRET=

# Contraseña del panel de administración (api/admin.ts).
ADMIN_PASSWORD=

# API key de Resend para el envío de emails (api/_lib/resend.ts).
RESEND_API_KEY=

# Token del bot de Telegram, de @BotFather (api/telegram-*.ts).
TELEGRAM_BOT_TOKEN=

# Secreto del webhook de Telegram (api/telegram-webhook.ts). Debe coincidir
# exactamente con el secret_token registrado en Telegram:
#   curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=https://www.sepeiunido.org/api/telegram-webhook&secret_token=<este valor>"
# Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Secreto que autentica al cron de Vercel que sincroniza el BOE
# (api/boe-search.ts, programado en vercel.json).
CRON_SECRET=
